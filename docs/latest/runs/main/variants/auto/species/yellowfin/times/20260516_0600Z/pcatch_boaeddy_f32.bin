:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=:Ѩ=