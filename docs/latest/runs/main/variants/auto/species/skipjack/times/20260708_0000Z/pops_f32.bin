$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>$ów>