%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=%од=