:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش=:ش