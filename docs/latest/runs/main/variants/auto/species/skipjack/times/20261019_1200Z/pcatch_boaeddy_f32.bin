וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=וd=