u供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供Au供A